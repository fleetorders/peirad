#!/usr/bin/env sh
# Machine-local companion checks, if this machine has any — first, so a
# companion reading the ref list on stdin still sees it. Resolution and the
# trust-grant note live in lib/companion.sh.
"$(dirname "$0")/lib/companion.sh" pre-push "$@"
rc=$?
[ "$rc" -ne 0 ] && exit "$rc"

# Repo-owned pre-push checks (etymd never touches this file). The generated hook already runs
# `npm run typecheck`; this adds the test suite, which is where every gate proves it fires.
# CI runs the suite too, but a failure there shows only after the push.
#
# The runner is wrapped in a scrub of git's exported environment. Git exports GIT_DIR and
# GIT_INDEX_FILE to every hook, and a child git obeys those over its own working directory —
# so a suite that builds fixture repositories can end up committing into THIS repository
# instead of into its fixture. The wrapper covers the whole runner rather than naming the
# variables to strip: one added by a future git version is scrubbed without anyone editing
# this line.
echo "› npm test (git environment scrubbed)"
# shellcheck disable=SC2046  # the split is the point: each name becomes its own `-u NAME` argument
env $(env | grep -o '^GIT_[A-Za-z0-9_]*' | sed 's/^/-u /') npm test || exit 1
